APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://bot.yzdoc.cn,https://bot.yzdoc.cn
QQBOT_API_BASE=https://api.bot.qq.com
QQBOT_TOKEN_URL=https://api.bot.qq.com/app/getAppAccessToken
QQBOT_REQUEST_TIMEOUT=15

# 百度网盘开放平台应用凭证，仅配置在服务端。前端通过设备码二维码授权。
BAIDU_PAN_APP_KEY=
BAIDU_PAN_SECRET_KEY=
BAIDU_OAUTH_BASE=https://openapi.baidu.com
BAIDU_OAUTH_TIMEOUT=15

# 管理台登录鉴权（多租户）
SESSION_SECRET=change-me-to-a-long-random-string
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-8-chars
# HTTPS 站点请设为 true，本地 http 调试可设 false
AUTH_COOKIE_SECURE=true
